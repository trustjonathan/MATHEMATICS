---
import '../../archive.css';
import logo from '../../logo.png';
import mathematicsImage from '../../mathematics.jpg';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="Search the Study Hub Mathematics archive for curriculum notes and exam practice resources." />
    <meta name="theme-color" content="#f4f5ef" />
    <link rel="canonical" href="https://trustjonathan.github.io/MATHEMATICS/archive.html" />
    <meta property="og:title" content="Mathematics Archive | Study Hub" />
    <meta property="og:description" content="Search Mathematics notes, worked examples, and exam practice resources from Study Hub." />
    <meta property="og:url" content="https://trustjonathan.github.io/MATHEMATICS/archive.html" />
    <meta property="og:image" content="https://trustjonathan.github.io/MATHEMATICS/mathematics.jpg" />
    <meta property="og:type" content="website" />
    <title>Mathematics Archive | Study Hub</title>
    <link rel="icon" href={logo.src} type="image/png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Manrope:wght@500;600;700;800&display=swap" rel="stylesheet" />
  </head>
  <body>
    <header class="site-header" id="top">
      <div class="utility-bar">
        <div class="utility-inner">
          <nav class="utility-links" aria-label="Utility navigation">
            <a href="https://trustjonathan.github.io/STUDY-HUB/frontend/src/html/about.html">About</a>
            <a href="mailto:trusteth777@gmail.com">Contact</a>
          </nav>
          <span class="utility-note">Made for Ugandan learners</span>
        </div>
      </div>
      <div class="header-main">
        <nav class="site-nav" aria-label="Mathematics archive navigation">
          <a href="https://trustjonathan.github.io/STUDY-HUB/">Home</a>
          <a href="#overview">Overview</a>
          <a href="#archive" aria-current="page">Archive</a>
        </nav>
        <a class="brand" href="https://trustjonathan.github.io/STUDY-HUB/" aria-label="Study Hub home">
          <img src={logo.src} width="38" height="38" alt="" />
          <span>Study Hub</span>
        </a>
        <nav class="header-actions" aria-label="Archive actions">
          <a href="#archive">Search archive</a>
          <a href="mailto:trusteth777@gmail.com?subject=Mathematics%20resource%20request">Request resource</a>
        </nav>
      </div>
      <nav class="mega-nav" aria-label="Study Hub links">
        <details class="mega-nav-group">
          <summary>Study Hub</summary>
          <div class="mega-nav-panel"><a href="https://trustjonathan.github.io/STUDY-HUB/">Home</a></div>
        </details>
        <details class="mega-nav-group">
          <summary>Biology</summary>
          <div class="mega-nav-panel">
            <a href="https://trustjonathan.github.io/STUDY-HUB/frontend/src/html/biology.html">Biology study hub</a>
            <a href="https://trustjonathan.github.io/BIOLOGY/archive.html">Biology archive</a>
          </div>
        </details>
        <details class="mega-nav-group">
          <summary>Chemistry</summary>
          <div class="mega-nav-panel">
            <a href="https://trustjonathan.github.io/STUDY-HUB/frontend/src/html/chemistry.html">Chemistry study hub</a>
            <a href="https://trustjonathan.github.io/CHEMISTRY/archive.html">Chemistry archive</a>
          </div>
        </details>
        <details class="mega-nav-group">
          <summary>Mathematics</summary>
          <div class="mega-nav-panel">
            <a href="https://trustjonathan.github.io/STUDY-HUB/frontend/src/html/mathematics.html">Mathematics study hub</a>
            <a href="https://trustjonathan.github.io/MATHEMATICS/archive.html">Mathematics archive</a>
          </div>
        </details>
        <details class="mega-nav-group">
          <summary>Support</summary>
          <div class="mega-nav-panel"><a href="mailto:trusteth777@gmail.com?subject=Mathematics%20resource%20request">Request a resource</a></div>
        </details>
      </nav>
    </header>

    <main>
      <section class="archive-intro" id="overview" aria-labelledby="page-title">
        <div class="intro-copy">
          <p class="eyebrow">Study Hub / Mathematics</p>
          <h1 id="page-title">Mathematics archive</h1>
          <p class="intro-description">Find notes, worked examples, and exam practice shared for focused revision.</p>
          <div class="page-nav" aria-label="Page navigation">
            <a href="#overview">Overview</a>
            <a href="#archive">Archive</a>
            <a href="#normal-pages">Normal pages</a>
          </div>
          <a class="text-link" href="#archive">Browse the archive <span aria-hidden="true">↓</span></a>
        </div>
        <figure class="intro-image">
          <img src={mathematicsImage.src} alt="Mathematical formulas and symbols" />
          <figcaption>Notes and practice for every stage of the Mathematics course.</figcaption>
        </figure>
      </section>

      <section class="normal-pages-strip" id="normal-pages" aria-labelledby="normal-pages-title">
        <div class="section-heading compact-heading">
          <div>
            <p class="eyebrow">Back to the main site</p>
            <h2 id="normal-pages-title">Normal pages</h2>
          </div>
        </div>
        <div class="page-link-grid">
          <a href="https://trustjonathan.github.io/STUDY-HUB/">Study Hub home</a>
          <a href="https://trustjonathan.github.io/STUDY-HUB/frontend/src/html/biology.html">Biology main page</a>
          <a href="https://trustjonathan.github.io/STUDY-HUB/frontend/src/html/chemistry.html">Chemistry main page</a>
          <a href="https://trustjonathan.github.io/STUDY-HUB/frontend/src/html/mathematics.html">Mathematics main page</a>
        </div>
      </section>

      <section class="archive-section" id="archive" aria-labelledby="archive-title">
        <div class="section-heading">
          <div>
            <p class="eyebrow">Browse resources</p>
            <h2 id="archive-title">The collection</h2>
          </div>
          <p>Search by title, topic, level, or year.</p>
        </div>

        <div class="archive-controls">
          <label class="search-field">
            <span>Search archive</span>
            <input id="archive-search" type="search" placeholder="Try calculus or 2024" autocomplete="off" />
          </label>
          <label class="select-field">
            <span>Level</span>
            <select id="level-filter">
              <option value="">All levels</option>
            </select>
          </label>
          <label class="select-field">
            <span>Sort</span>
            <select id="sort-order">
              <option value="title">Title</option>
              <option value="recent">Recently added</option>
              <option value="year">Year</option>
            </select>
          </label>
        </div>

        <div class="archive-tabs" role="group" aria-label="Filter by resource type">
          <button type="button" data-category="all" aria-pressed="true">All resources</button>
          <button type="button" data-category="notes" aria-pressed="false">Notes</button>
          <button type="button" data-category="papers" aria-pressed="false">Past papers</button>
        </div>

        <p class="archive-status" id="archive-status" role="status" aria-live="polite">Connecting to the shared archive...</p>
        <div class="resource-list" id="resource-list" aria-live="polite"></div>
        <button class="button button-outline load-more" id="load-more" type="button" hidden>Load more</button>
      </section>

      <section class="contribute-band" aria-labelledby="contribute-title">
        <div>
          <p class="eyebrow">Support the library</p>
          <h2 id="contribute-title">Have a useful Mathematics resource?</h2>
          <p>Share notes or practice material. Submissions are reviewed before they are added to the public archive.</p>
        </div>
        <button class="button button-light" id="open-contribution" type="button">Submit a resource <span aria-hidden="true">+</span></button>
      </section>
    </main>

    <footer class="site-footer" id="footer-links">
      <div class="footer-group">
        <h3>Study Hub</h3>
        <a href="https://trustjonathan.github.io/STUDY-HUB/">Home</a>
        <a href="#overview">Overview</a>
        <a href="#normal-pages">Normal pages</a>
      </div>
      <div class="footer-group">
        <h3>Subjects</h3>
        <a href="https://trustjonathan.github.io/STUDY-HUB/frontend/src/html/biology.html">Biology</a>
        <a href="https://trustjonathan.github.io/STUDY-HUB/frontend/src/html/chemistry.html">Chemistry</a>
        <a href="https://trustjonathan.github.io/STUDY-HUB/frontend/src/html/mathematics.html">Mathematics</a>
      </div>
      <div class="footer-group">
        <h3>Archives</h3>
        <a href="https://trustjonathan.github.io/BIOLOGY/archive.html">Biology archive</a>
        <a href="https://trustjonathan.github.io/CHEMISTRY/archive.html">Chemistry archive</a>
        <a href="https://trustjonathan.github.io/MATHEMATICS/archive.html">Mathematics archive</a>
      </div>
      <div class="footer-brand">
        <a class="brand" href="https://trustjonathan.github.io/STUDY-HUB/">
          <img src={logo.src} width="32" height="32" alt="" />
          <span>Study Hub / Mathematics</span>
        </a>
        <p>Free study resources for focused, confident revision.</p>
        <a class="back-to-top" href="#top">Back to top <span aria-hidden="true">↑</span></a>
      </div>
    </footer>

    <dialog class="contribution-dialog" id="contribution-dialog" aria-labelledby="contribution-title">
      <form id="contribution-form">
        <div class="dialog-heading">
          <div>
            <p class="eyebrow">Community contribution</p>
            <h2 id="contribution-title">Submit a resource</h2>
          </div>
          <button class="icon-button" id="close-contribution" type="button" aria-label="Close">×</button>
        </div>
        <p class="dialog-note">Uploads stay private until reviewed. Only share materials you have permission to distribute.</p>

        <label class="form-field">
          <span>Resource title</span>
          <input name="title" type="text" minlength="3" maxlength="120" required />
        </label>
        <div class="form-grid">
          <label class="form-field">
            <span>Collection</span>
            <select name="category" required>
              <option value="notes">Notes</option>
              <option value="papers">Past papers</option>
            </select>
          </label>
          <label class="form-field">
            <span>Level (optional)</span>
            <select name="level">
              <option value="">Not specified</option>
              <option value="O-Level">O-Level</option>
              <option value="A-Level">A-Level</option>
              <option value="S.3">S.3</option>
              <option value="S.4">S.4</option>
              <option value="S.5">S.5</option>
              <option value="S.6">S.6</option>
            </select>
          </label>
        </div>
        <label class="form-field">
          <span>Year (optional)</span>
          <input name="year" type="number" min="1990" max="2035" inputmode="numeric" />
        </label>
        <label class="form-field">
          <span>File</span>
          <input name="file" type="file" accept=".pdf,.doc,.docx,.rtf,.txt" required />
          <small>PDF, Word, RTF, or text file. Maximum 50 MB.</small>
        </label>
        <label class="rights-check">
          <input name="rights_confirmed" type="checkbox" required />
          <span>I have permission to share this material with the public.</span>
        </label>
        <div class="verification" id="turnstile-widget"></div>
        <p class="upload-status" id="upload-status" role="status" aria-live="polite">Uploads require verification and are reviewed before publication.</p>
        <div class="dialog-actions">
          <button class="button button-outline" id="cancel-contribution" type="button">Cancel</button>
          <button class="button button-primary" id="submit-contribution" type="submit" disabled>Send for review</button>
        </div>
      </form>
    </dialog>

    <script>
      const desktopHover = window.matchMedia('(hover: hover) and (min-width: 761px)');
      document.querySelectorAll<HTMLDetailsElement>('.mega-nav-group').forEach((group) => {
        group.addEventListener('pointerenter', () => {
          if (desktopHover.matches) group.open = true;
        });
        group.addEventListener('pointerleave', () => {
          if (desktopHover.matches && !group.contains(document.activeElement)) group.open = false;
        });
        group.addEventListener('focusin', () => {
          if (desktopHover.matches) group.open = true;
        });
        group.addEventListener('focusout', (event) => {
          const nextTarget = event.relatedTarget;
          if (desktopHover.matches && !(nextTarget instanceof Node && group.contains(nextTarget)) && !group.matches(':hover')) {
            group.open = false;
          }
        });
      });
    </script>
    <script src="../scripts/archive-entry.js"></script>
  </body>
</html>